# Dockerfile.api — FastAPI server image (no Playwright)

# --- Stage 1: build React GUI (gui/dist) ---
FROM node:20-slim AS gui-build
WORKDIR /gui
COPY src/footstats/gui/package.json src/footstats/gui/package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY src/footstats/gui ./
RUN npm run build

# --- Stage 2: FastAPI runtime ---
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

COPY pyproject.toml ./
COPY requirements-api.lock ./
COPY src ./src
COPY --from=gui-build /gui/dist ./src/footstats/gui/dist

# Dataset Poissona (32k meczów, 562 KB). Ten obraz serwuje NIE TYLKO API — chodzi na
# nim `/cron/draft`, czyli to co tworzy kupony System (nasze dane walidacyjne).
# Bez parquetu `load_cached()` zwraca None i draft robi cichy fallback na bzzoiro-ml
# zamiast Poisson-DC (potwierdzone dry-runem na prodzie 29.07: model_source=bzzoiro-ml).
# Wymaga negacji `!data/hist_cache/full_dataset.parquet` w .dockerignore — bez niej
# ten COPY wywala build ("not found", plik wycięty z kontekstu).
COPY data/hist_cache/full_dataset.parquet ./data/hist_cache/full_dataset.parquet
COPY data/hist_cache/af_stats.parquet ./data/hist_cache/af_stats.parquet

# Aliasy nazw drużyn. Bez tego pliku `normalize.py` zapisuje w kontenerze swoje
# `_DEFAULT_MAPPINGS` i rusza dalej — czyli obraz działa, tylko nie zna nazw
# przejrzanych ręcznie (cała Bundesliga z The Odds API) i gubi te mecze.
COPY data/team_mappings.json ./data/team_mappings.json
COPY data/rozszczepione_kluby.json ./data/rozszczepione_kluby.json

# Kalibracja λ. Bez tego pliku `load_calibration()` zwraca neutralne (1.0, 1.0)
# i cała warstwa kalibracji jest w kontenerze dekoracją — a pomiary robione
# lokalnie opisują wtedy inny model niż ten, który liczy predykcje na produkcji.
COPY data/model_calibration.json ./data/model_calibration.json

# Wzorce RAG — ten obraz też liczy predykcje (`/cron/draft`), więc potrzebuje
# tego samego paliwa co joby.
COPY data/rag_wzorce_historyczne.json ./data/rag_wzorce_historyczne.json

# Zrzut goli zawodnikow — patrz komentarz w Dockerfile.jobs. `/cron/draft`
# chodzi na SERWISIE, wiec bez tego pliku ma dokladnie ten sam martwy
# kanal team-news co joby.
COPY data/player_stats.json ./data/player_stats.json

# Zaleznosci z LOCKA — uzasadnienie w Dockerfile.jobs. Lock dla samego [api]:
#   uv pip compile pyproject.toml --extra api \
#     --python-platform linux --python-version 3.12 -o requirements-api.lock
RUN uv pip install --system -r requirements-api.lock \
    && uv pip install --system --no-deps . \
    && mkdir -p /app/data

RUN addgroup --system app && adduser --system --ingroup app app \
    && chown -R app:app /app
USER app

EXPOSE 8000

CMD uvicorn footstats.api.main:app --host 0.0.0.0 --port ${PORT:-8000}
