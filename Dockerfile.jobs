# Dockerfile.jobs — obraz Cloud Run Jobs dla PEŁNEGO pipeline (Playwright + Groq).
# Odróżnia się od Dockerfile.api (ten jest lekki, bez Playwright, serwuje FastAPI).
# Cel: uruchamiać `daily_agent --faza final` (11:00 CEST) + `evening_agent` (23:00 CEST)
# PC-niezależnie przez Cloud Scheduler → Cloud Run Jobs. Faza wybierana przez JOB_PHASE.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    JOB_PHASE=final

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

COPY pyproject.toml ./
COPY requirements-jobs.lock ./
COPY src ./src

# Dataset Poissona (32k meczów, ~0.56MB) — bez niego cloud-draft robi fallback na
# bzzoiro-ml zamiast Poisson-DC (patrz core/cloud_draft.py). Plik jest .gitignore'owany
# (force-added do repo), a .gcloudignore go NIE wyklucza → trafia do build-contextu.
COPY data/hist_cache/full_dataset.parquet ./data/hist_cache/full_dataset.parquet
COPY data/hist_cache/af_stats.parquet ./data/hist_cache/af_stats.parquet

# Aliasy nazw drużyn — joby rozliczają mecze, więc nierozpoznana nazwa to nie
# tylko brak predykcji, ale i kupon, którego nikt nie zamknie.
COPY data/team_mappings.json ./data/team_mappings.json
COPY data/rozszczepione_kluby.json ./data/rozszczepione_kluby.json

# Kalibracja λ — joby liczą draft i predykcje wieczorne tym samym modelem
# co API, więc muszą znać te same factory.
COPY data/model_calibration.json ./data/model_calibration.json

# Wzorce czynnik→typ z historii — jedyne paliwo warstwy RAG. Własnych
# rozliczonych predykcji z czynnikami jest ZERO i będzie tak tygodniami,
# więc bez tego pliku `pobierz_rag_wzorce` zwraca pusty string zawsze.
COPY data/rag_wzorce_historyczne.json ./data/rag_wzorce_historyczne.json

# Zrzut goli zawodnikow (`scripts/eksport_player_stats.py`). Bazy
# `footstats_backtest.db` w obrazie NIE MA i nie bedzie — jest wykluczona
# w .dockerignore i .gcloudignore. Bez tego pliku `player_db` dostaje
# `no such table: player_stats` (105 wpisow na stderr w jednym przebiegu
# 06.09.2026), goal_share schodzi do zera, `_policz_edge_absencji` wychodzi
# na `continue` i CALY kanal team-news jest martwy: p_over_abs,
# edge_absencje i rynek_p_over nie powstaja nigdy.
COPY data/player_stats.json ./data/player_stats.json

# Zależności: api (sentry/psycopg2) + ai (groq/langfuse) + scraper (playwright/bs4).
# NIE tylko [api] — daily_agent/evening potrzebują groq (Groq) i bs4 (scraper sędziów).
# Zaleznosci z LOCKA, nie z zakresow ">=". Bez tego dwa buildy tego samego commita
# moga zainstalowac rozne wersje, a zla wersja z gory wchodzi na produkcje po cichu —
# ta sama rodzina awarii co wycofany model Groqa (16-22.08).
# Lock generowany na platforme KONTENERA, nie hosta:
#   uv pip compile pyproject.toml --extra api --extra ai --extra scraper \
#     --python-platform linux --python-version 3.12 -o requirements-jobs.lock
# Zgodnosci locka z pyproject pilnuje tests/test_lockfile_zgodny.py.
RUN uv pip install --system -r requirements-jobs.lock \
    && uv pip install --system --no-deps . \
    && playwright install --with-deps chromium \
    && mkdir -p /app/data

# Entrypoint dispatchuje na JOB_PHASE:
#   final   → python -m footstats.daily_agent --faza final
#   evening → python -m footstats.evening_agent
COPY scripts/run_job.sh /app/run_job.sh
# Strip CR (Windows CRLF → LF): host checkout na Windows daje \r\n, co w Linuxie
# psuje shebang (`env: bash\r` → exit 127) i case-blok. sed gwarantuje LF w obrazie.
RUN sed -i 's/\r$//' /app/run_job.sh && chmod +x /app/run_job.sh

CMD ["bash", "/app/run_job.sh"]
